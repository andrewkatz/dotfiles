#!/usr/bin/env python3
"""Things Andrew has to do himself after a task (email a client, tell someone it shipped).
Each one is sent to his phone (Telegram, @katz_hermes_bot) and stays pinned in red in the
conductor view until he clears it.

  conductor-followup add --task N --who "Tiffany (Acme)" --what "Tell her the export fix is live" [--draft FILE]
  conductor-followup list [--json]       open follow-ups
  conductor-followup done F3 [F4 ...]    clear them (Andrew said he did it, or "F3 done")
  conductor-followup remind              re-send open follow-ups not sent in the last 20h (daily job)
  conductor-followup test                send a test message

Telegram goes straight to the Bot API from katz-mini (the token never leaves it), no LLM in the path.
If Telegram fails the follow-up is still recorded (sent: null) and `remind` retries it.
"""
import argparse, base64, datetime, json, os, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
LEDGER = os.path.join(HERE, "conductor-ledger")
SEND = r'''
import json, os, sys, urllib.request
env = dict(l.rstrip("\n").split("=", 1) for l in open(os.path.expanduser("~/.hermes/.env")) if "=" in l and not l.startswith("#"))
tok, chat = env["TELEGRAM_BOT_TOKEN"].strip(), env["TELEGRAM_HOME_CHANNEL"].strip()
body = json.dumps({"chat_id": chat, "text": sys.stdin.read()[:4000], "disable_web_page_preview": True}).encode()
r = urllib.request.Request("https://api.telegram.org/bot%s/sendMessage" % tok, data=body, headers={"Content-Type": "application/json"})
print(json.load(urllib.request.urlopen(r, timeout=20)).get("ok"))
'''


def task_title(tid):
    """Short title for a task id: ledger first, then the developerly DB (read-only)."""
    if not tid:
        return ""
    try:
        t = json.load(open(os.path.expanduser("~/.local/share/conductor/ledger.json"))).get("tasks", {}).get(str(tid), {})
        if t.get("title"):
            return t["title"]
        import sqlite3
        con = sqlite3.connect(f"file:{os.path.expanduser('~/.local/share/developerly/developerly.db')}?mode=ro", uri=True)
        row = con.execute("select title from tasks where id = ?", (int(tid),)).fetchone()
        return row[0] if row else ""
    except Exception:
        return ""


def task_label(tid):
    """'<title> (2170)' - how Andrew-facing text names a task."""
    if not tid:
        return ""
    t = task_title(tid)
    return f"{t[:70]} ({tid})" if t else f"task {tid}"


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def ledger(*args):
    r = subprocess.run([LEDGER, *args], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"conductor-ledger {args[0]} failed: {r.stderr.strip()}")
    return r.stdout.strip()


def followups():
    try:
        return list(json.loads(ledger("get", "andrew_followups")).values())
    except (SystemExit, AttributeError):
        return []


def telegram(text):
    try:
        code = base64.b64encode(SEND.encode()).decode()
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "katz-mini",
                            f"python3 -c 'import base64; exec(base64.b64decode(\"{code}\"))'"],
                           input=text, capture_output=True, text=True, timeout=60)
        return r.returncode == 0 and r.stdout.strip() == "True"
    except subprocess.TimeoutExpired:
        return False


def message(f, again=False):
    head = f"{'Reminder - ' if again else ''}Conductor follow-up {f['id']}" + (f" - {task_label(f['task'])}" if f.get("task") else "")
    lines = [head, f"{f['who']}: {f['what']}" if f.get("who") else f["what"]]
    if f.get("draft"):
        lines += ["", "Draft:", f["draft"]]
    lines += ["", f'Clear it: tell the conductor "{f["id"]} done".']
    return "\n".join(lines)


def update(f, **kw):
    ledger("merge", f"andrew_followups.{f['id']}", json.dumps(kw))


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add")
    a.add_argument("--task")
    a.add_argument("--who", default="")
    a.add_argument("--what", required=True)
    a.add_argument("--draft")
    l = sub.add_parser("list")
    l.add_argument("--json", action="store_true")
    d = sub.add_parser("done")
    d.add_argument("ids", nargs="+")
    sub.add_parser("remind")
    sub.add_parser("test")
    o = p.parse_args()

    if o.cmd == "test":
        print("sent" if telegram("Conductor test: follow-ups will arrive here.") else "telegram failed")
        return
    if o.cmd == "add":
        import re
        if re.search(r"/triage|\b(new|create|file|open)( a| \w+)? tasks?\b|\bpaste into\b", o.what, re.I):
            sys.exit("refused: that's task work - create it yourself with `developerly work-items create` "
                     "(policy.md \"Create\"); follow-ups are only for things Andrew must do personally")
        f = {"id": ledger("next-id", "F"), "task": o.task, "who": o.who, "what": o.what,
             "draft": open(o.draft).read().strip() if o.draft else "", "status": "open", "created": now(), "sent": None}
        ok = telegram(message(f))
        f["sent"] = now() if ok else None
        ledger("set", f"andrew_followups.{f['id']}", json.dumps(f))
        ledger("log", str(o.task or "-"), "followup", f"{f['id']} {o.who}: {o.what}")
        print(f"{f['id']} {'sent to telegram' if ok else 'recorded; telegram FAILED (remind retries)'}")
        return
    fs = followups()
    if o.cmd == "list":
        open_ = [f for f in fs if f.get("status") == "open"]
        if o.json:
            print(json.dumps(open_, indent=1))
        for f in [] if o.json else open_:
            print(f"{f['id']} {task_label(f.get('task')) or '-'}  {f['who'] + ': ' if f.get('who') else ''}{f['what']}")
        return
    if o.cmd == "done":
        want = {i.upper() for i in o.ids}
        hit = [f for f in fs if f["id"] in want and f.get("status") == "open"]
        for f in hit:
            update(f, status="done", cleared=now())
        print("cleared " + (" ".join(f["id"] for f in hit) or "nothing"))
        return
    if o.cmd == "remind":
        cutoff = datetime.datetime.now() - datetime.timedelta(hours=20)
        n = 0
        for f in fs:
            if f.get("status") != "open":
                continue
            last = f.get("sent")
            if last and datetime.datetime.fromisoformat(last) > cutoff:
                continue
            if telegram(message(f, again=bool(last))):
                update(f, sent=now())
                n += 1
        print(f"reminded {n}")


if __name__ == "__main__":
    main()
