#!/usr/bin/env python3
"""Locked, atomic access to the conductor ledger. Use this instead of reading/writing the JSON by hand.

  conductor-ledger get [PATH]            print JSON at PATH (default: hot summary, see below)
  conductor-ledger set PATH JSON         replace value at PATH
  conductor-ledger merge PATH JSON       shallow-merge a JSON object into PATH (creates it)
  conductor-ledger merge-id PATH ID EXPECT PATCH  merge one stable list ID, checking EXPECT under lock
  conductor-ledger append PATH JSON      append to the list at PATH (creates it)
  conductor-ledger del PATH              delete PATH
  conductor-ledger take PATH             print JSON at PATH and delete it, atomically ([] / {} if missing)
  conductor-ledger next-id PREFIX        allocate the next id for Q / D / J (e.g. Q31) and print it
  conductor-ledger log TASK ACTION [DETAIL]   append one line to ledger.log
  conductor-ledger summary               compact view: active tasks, open questions, jobs, overrides

PATH is dot-separated: tasks.2110.stage, questions, questions.3.status (list index), overrides.pins, hermes.items.
A write can't change a list/dict into another type, and list entries are only addressed by index.
Top-level keys live in separate files so routine reads stay small:
  hermes -> hermes.json (board verdict cache), done -> done.json, archive -> archive.json
  (answered questions, old decisions), everything else -> ledger.json.
"""
import datetime, fcntl, json, os, re, sys
from contextlib import contextmanager

DIR = os.path.expanduser("~/.local/share/conductor")
FILES = {"hermes": "hermes.json", "done": "done.json", "archive": "archive.json"}
MAIN = "ledger.json"


def file_for(path):
    return os.path.join(DIR, FILES.get(path.split(".")[0], MAIN))


@contextmanager
def locked():
    os.makedirs(DIR, exist_ok=True)
    with open(os.path.join(DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def read(f):
    try:
        return json.load(open(f))
    except FileNotFoundError:
        return {}


def write(f, data):
    tmp = f + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, f)


def walk(data, keys, create=False):
    for k in keys:
        if isinstance(data, list):  # list entries by index: questions.3.status
            data = data[int(k)] if k.lstrip("-").isdigit() and -len(data) <= int(k) < len(data) else None
            if data is None:
                raise KeyError(".".join(keys))
            continue
        if k not in data:
            if not create:
                raise KeyError(".".join(keys))
            data[k] = {}
        data = data[k]
    return data


def load_doc(path):
    f = file_for(path)
    doc = read(f)
    top = path.split(".")[0]
    if f != os.path.join(DIR, MAIN):
        doc = {top: doc}
    return f, doc


def save_doc(f, path, doc):
    top = path.split(".")[0]
    write(f, doc[top] if f != os.path.join(DIR, MAIN) else doc)


def summary():
    led = read(os.path.join(DIR, MAIN))
    tasks = {k: {x: v.get(x) for x in ("stage", "session", "base", "pr", "job") if v.get(x) is not None}
             for k, v in led.get("tasks", {}).items()}
    qs = [{k: q.get(k) for k in ("id", "task", "blocking", "question")} for q in led.get("questions", []) if q.get("status") == "open"]
    return {"tasks": tasks, "open_questions": qs, "jobs": led.get("jobs", {}),
            "overrides": led.get("overrides", {}), "last_order_review": led.get("last_order_review")}


STOP = set("about after again also before being could does from have into just more once only other over same should "
           "some than that their them then there these they this those what when where which will with would your".split())


def words(text):
    return {w for w in re.findall(r"[a-z0-9*:]+", (text or "").lower()) if len(w) > 3 and w not in STOP}


def overlaps(q, new):
    """Same task, or two proposals whose titles share most of their words."""
    if new.get("task") is not None and str(q.get("task")) == str(new.get("task")):
        return True
    a, b = words((q.get("proposal") or {}).get("title")), words((new.get("proposal") or {}).get("title"))
    return bool(a and b) and len(a & b) / min(len(a), len(b)) >= 0.6


def check_duplicate_question(qs, new):
    """Andrew, 2026-10-22: the conductor kept queuing near-duplicate questions. A new open question must say how it
    relates to every open question on the same task (or a proposal with a similar title): `replaces` withdraws them
    in favour of this one, `distinct_from` confirms they need separate answers."""
    if new.get("status", "open") != "open":
        return
    replaces, distinct = set(new.get("replaces") or []), set(new.get("distinct_from") or [])
    hits = [q for q in qs if q.get("status") == "open" and overlaps(q, new) and q.get("id") not in replaces | distinct]
    if hits:
        lines = "\n".join(f"  {q['id']} (task {q.get('task')}): {q.get('question', '')[:200]}" for q in hits)
        sys.exit(f"refused: open questions that may already cover this:\n{lines}\n"
                 "Prefer one question: update the existing one in place (`merge-id questions Q<n> EXPECT PATCH` with the "
                 "new question/options and asked_at null, then `ask: Q<n>` again), or fold the old one into this entry "
                 "with \"replaces\": [\"Q<n>\"] (it gets withdrawn). Only if each needs its own answer, add "
                 "\"distinct_from\": [\"Q<n>\"].")
    for q in qs:
        if q.get("id") in replaces and q.get("status") == "open":
            q.update(status="withdrawn", answer=f"replaced by {new.get('id')}")


def main():
    a = sys.argv[1:]
    if not a or a[0] == "summary":
        print(json.dumps(summary(), indent=1))
        return
    cmd = a[0]
    with locked():
        if cmd == "log":
            # TASK ACTION [DETAIL...]; a bare `log "message"` is logged with task "-" instead of crashing
            if len(a) < 2:
                sys.exit("usage: conductor-ledger log TASK ACTION [DETAIL]")
            task, action, rest = (a[1], a[2], a[3:]) if len(a) > 2 else ("-", a[1], [])
            entry = {"ts": datetime.datetime.now().isoformat(timespec="seconds"), "task": task, "action": action,
                     "detail": " ".join(rest)}
            with open(os.path.join(DIR, "ledger.log"), "a") as fh:
                fh.write(json.dumps(entry) + "\n")
            return
        if cmd == "next-id":
            prefix = a[1]
            f = os.path.join(DIR, MAIN)
            doc = read(f)
            n = doc.setdefault("next_ids", {}).get(prefix, 1)
            n = max([n, int(doc.pop("next_" + prefix.lower(), 0))] + [  # never reuse: skip past any id already used
                int(m) + 1 for name in (MAIN, "archive.json", "done.json") if os.path.exists(os.path.join(DIR, name))
                # ids appear as "id" values, as map keys ("D165": ...) and inside notes ("D167: ...")
                for m in re.findall(r'(?<![\w-])' + re.escape(prefix) + r'(\d{1,5})\b', open(os.path.join(DIR, name)).read())])
            doc["next_ids"][prefix] = n + 1
            write(f, doc)
            print(f"{prefix}{n}")
            return
        if cmd == "get" and len(a) == 1:
            print(json.dumps(summary(), indent=1))
            return
        path = a[1]
        keys = path.split(".")
        if cmd != "get" and keys[0] == "tasks" and len(keys) > 1 and not keys[1].isdigit():
            sys.exit(f"refused: task key must be the bare id (tasks.2216), not {keys[1]!r}")
        f, doc = load_doc(path)
        if cmd == "take":
            try:
                parent = walk(doc, keys[:-1])
                val = parent.pop(keys[-1])
            except KeyError:
                print("[]")
                return
            save_doc(f, path, doc)
            print(json.dumps(val, indent=1))
            return
        if cmd == "get":
            print(json.dumps(walk(doc, keys), indent=1))
            return
        if cmd == "merge-id":
            if len(a) != 5:
                sys.exit("usage: conductor-ledger merge-id PATH ID EXPECT_JSON PATCH_JSON")
            values = walk(doc, keys)
            expected, patch = json.loads(a[3]), json.loads(a[4])
            if not isinstance(values, list) or not isinstance(expected, dict) or not isinstance(patch, dict):
                sys.exit("refused: merge-id requires a list and object expectation/patch")
            matches = [v for v in values if isinstance(v, dict) and v.get("id") == a[2]]
            if len(matches) != 1:
                sys.exit("refused: stable ID must match exactly one entry")
            entry = matches[0]
            if any(entry.get(k) != v for k, v in expected.items()):
                sys.exit("refused: stable ID entry changed; reread before reconciling")
            if "id" in patch and patch["id"] != a[2]:
                sys.exit("refused: cannot change stable ID")
            entry.update(patch)
            save_doc(f, path, doc)
            print("ok")
            return
        parent = walk(doc, keys[:-1], create=True)
        if isinstance(parent, list) and not keys[-1].lstrip("-").isdigit():
            sys.exit(f"refused: {'.'.join(keys[:-1])} is a list; add with `append {'.'.join(keys[:-1])} JSON` (index entries by number)")
        if cmd == "set":
            new = json.loads(a[2])
            cur = parent[int(keys[-1])] if isinstance(parent, list) else parent.get(keys[-1])
            if isinstance(cur, (list, dict)) and type(new) is not type(cur):
                sys.exit(f"refused: {path} is a {type(cur).__name__}; setting a {type(new).__name__} would replace it all")
            if isinstance(parent, list):
                parent[int(keys[-1])] = new
            else:
                parent[keys[-1]] = new
        elif isinstance(parent, list):
            i = int(keys[-1])
            if cmd == "merge":
                parent[i].update(json.loads(a[2]))
            elif cmd == "append":
                parent[i].append(json.loads(a[2]))
            elif cmd == "del":
                parent.pop(i)
            else:
                sys.exit(f"unknown command {cmd}")
        elif cmd == "merge":
            parent.setdefault(keys[-1], {}).update(json.loads(a[2]))
        elif cmd == "append":
            new = json.loads(a[2])
            if path == "questions":
                check_duplicate_question(parent.get("questions", []), new)
            parent.setdefault(keys[-1], []).append(new)
        elif cmd == "del":
            parent.pop(keys[-1], None)
        else:
            sys.exit(f"unknown command {cmd}")
        save_doc(f, path, doc)
        print("ok")


if __name__ == "__main__":
    try:
        main()
    except KeyError as e:
        sys.exit(f"not found: {e}")
