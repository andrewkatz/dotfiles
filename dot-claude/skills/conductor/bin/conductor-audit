#!/usr/bin/env python3
"""Find work the conductor dropped: things that should be moving and aren't.

  conductor-audit            one line per problem, with the fix (the tick runs this first and handles every line)
  conductor-audit --no-gh    skip the per-PR GitHub checks (PR status is cached 10 min per PR + head SHA anyway)
  conductor-audit --new      only problems not reported in the last 30 min (conductor-web-wait uses this to wake
                             the dispatcher without nagging about the same thing every 5 minutes)

Checks: green PRs left unmerged, idle workers in a working stage, failed launches, waiting tasks whose
condition already happened, investigations left open, free slots with todo work, ledger/developerly drift,
stale job entries, malformed ledger keys, approved proposals never created, Docker stacks left running for tasks past testing,
VIA beta/production /up down or slow.
"""
import datetime, json, os, re, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
DIR = os.path.expanduser("~/.local/share/conductor")
SEEN = os.path.join(DIR, "audit-seen.json")
PER_PROJECT, TOTAL = 4, 6
PAUSED_PROJECTS = {"Inn Management"}
WORKING = {"spec", "implementing", "testing", "qa", "review", "shipping"}
WAITING = {"waiting", "escalated", "blocked", "parked"}
IDLE_MIN, LAUNCH_MIN, GREEN_MIN, JOB_HOURS = 15, 10, 10, 3
HEALTH = ["https://beta.via.tools/up", "https://app.via.tools/up"]
SLOW_SECS = 5


def ts(s):
    """Ledger times: naive local ISO, or with an offset/Z. -> epoch seconds (None if unparseable)."""
    if not s:
        return None
    s = str(s).replace("Z", "+00:00")
    s = re.sub(r"([+-]\d{2})(\d{2})$", r"\1:\2", s)
    try:
        d = datetime.datetime.fromisoformat(s)
    except ValueError:
        return None
    return d.timestamp()


def mins(epoch):
    return (time.time() - epoch) / 60 if epoch else None


def sync(*args):
    r = subprocess.run([os.path.join(HERE, "conductor-sync"), "--json", *args], capture_output=True, text=True, timeout=120)
    return json.loads(r.stdout or "[]")


CACHE = os.path.join(DIR, "cache", "pr-status")
CACHE_TTL = 600  # 10 min; keyed by PR number + head SHA, so a new push invalidates it


def head_sha(cwd):
    try:
        return subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, timeout=10,
                              cwd=cwd).stdout.strip() or "nosha"
    except Exception:  # noqa: BLE001
        return "nosha"


def pr_green(pr, cwd):
    if "--no-gh" in sys.argv:  # conductor-web-wait: GitHub checks only every 15 min (REST rate limit)
        return False
    cwd = cwd if cwd and os.path.isdir(cwd) else None
    path = os.path.join(CACHE, f"{pr}-{head_sha(cwd) if cwd else 'nosha'}.json")
    try:
        if time.time() - os.path.getmtime(path) < CACHE_TTL:
            return json.load(open(path))["green"]
    except Exception:  # noqa: BLE001
        pass
    green = _pr_green(pr, cwd)
    try:
        os.makedirs(CACHE, exist_ok=True)
        for old in os.listdir(CACHE):
            if old.startswith(f"{pr}-"):
                os.remove(os.path.join(CACHE, old))
        json.dump({"green": green}, open(path, "w"))
    except OSError:
        pass
    return green


def _pr_green(pr, cwd):
    try:
        r = subprocess.run(["gh", "pr", "view", str(pr), "--json", "state,mergeable,statusCheckRollup"],
                           capture_output=True, text=True, timeout=60, cwd=cwd if cwd and os.path.isdir(cwd) else None)
        d = json.loads(r.stdout)
    except Exception:  # noqa: BLE001
        return False
    if d.get("state") != "OPEN" or d.get("mergeable") == "CONFLICTING":
        return False
    checks = [c.get("conclusion") or c.get("status") for c in d.get("statusCheckRollup") or []]
    return bool(checks) and all(c in ("SUCCESS", "SKIPPED", "NEUTRAL") for c in checks)


def main():
    led = json.load(open(os.path.join(DIR, "ledger.json")))
    tasks = led.get("tasks", {})
    last = {}  # task id -> epoch of its latest ledger.log entry
    try:
        for line in open(os.path.join(DIR, "ledger.log")):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            t = ts(e.get("ts"))
            if t:
                last[str(e.get("task"))] = max(last.get(str(e.get("task")), 0), t)
    except FileNotFoundError:
        pass
    live = {str(s["local_id"]): s for s in sync()}
    todo_all = {str(t["local_id"]): t for t in sync("--todo") if t.get("status") in ("todo", "in_progress")}
    todo = [t for t in todo_all.values() if t.get("status") == "todo" and t.get("project") not in PAUSED_PROJECTS]
    jobs = {k: v for k, v in (led.get("jobs") or {}).items() if v}
    running = {str(v.get("task")) for v in jobs.values() if not v.get("ended") and "done" not in str(v.get("status", ""))}
    followups = led.get("andrew_followups") or {}
    questions = led.get("questions") or {}
    qs = questions.values() if isinstance(questions, dict) else questions
    open_ids = {f["id"] for f in followups.values() if f.get("status", "open") == "open"} | \
               {q["id"] for q in qs if isinstance(q, dict) and q.get("status") in ("open", "asked")}
    out = []

    for k in tasks:
        if not k.isdigit():
            out.append(f"ledger key tasks.{k!r} isn't a bare id -> merge it into the real task and delete it")

    for tid, t in tasks.items():
        if not isinstance(t, dict) or not tid.isdigit():
            continue
        stage, s = t.get("stage"), live.get(tid)
        name = f"{(t.get('title') or (s or {}).get('title') or '')[:60]} ({tid})"
        since = ts(t.get("since")) or ts(t.get("launched_at"))
        quiet = mins(max(last.get(tid, 0), since or 0)) or 0
        if stage in WORKING and tid not in running:
            if s is None or not s.get("session"):
                if stage != "spec" and (mins(since) or 0) > LAUNCH_MIN:
                    out.append(f"{name}: stage {stage} but no worker session -> launch check: find the error, relaunch")
            elif s.get("session_status") == "idle" and quiet > IDLE_MIN:
                out.append(f"{name}: {stage}, worker idle and nothing logged for {quiet:.0f} min -> take its next step now")
        if stage in WORKING and s and str(s.get("pr_state") or "").upper() == "MERGED" and tid not in running:
            out.append(f"{name}: PR #{s.get('pr_number')} already merged (worker merged it?) -> verify base + head, move to deploying")
        if stage == "shipping" and s and s.get("pr_number") and tid not in running and quiet > GREEN_MIN \
                and pr_green(s["pr_number"], s.get("worktree")):
            out.append(f"{name}: PR #{s['pr_number']} CI green, not merged -> run its merge gate now")
        if stage in WAITING:
            refs = set(re.findall(r"\b[FQ]\d+\b", str(t.get("resume_when") or "")))
            if refs and not (refs & open_ids):
                out.append(f"{name}: {stage} on {', '.join(sorted(refs))}, all closed -> advance it (resume_when: {str(t.get('resume_when'))[:80]})")
            elif not refs and not t.get("resume_when") and not any(q.get("task") in (tid, int(tid)) for q in qs if isinstance(q, dict) and q.get("id") in open_ids):
                out.append(f"{name}: {stage} with no resume_when and no open question -> give it a way back or move it")
        if stage == "findings" and any(str(f.get("task")) == tid for f in followups.values()) and tid not in running:
            out.append(f"{name}: findings delivered -> complete the investigation (or launch its fix)")
        if stage in ("done", "dropped"):
            dev = s or todo_all.get(tid)
            if dev:
                ref = f"wi:{dev['work_item_id']}" if dev.get("work_item_id") else f"local:{tid}"
                out.append(f"{name}: ledger says {stage}, developerly still {dev.get('status')} -> "
                           f"developerly work-items complete {ref} --confirm={ref}, then move it to done")
            else:
                out.append(f"{name}: {stage} and gone from developerly -> move tasks.{tid} to done.{tid} (off the dashboard)")
        # dev_stack_in_use keeps its Docker stack out of conductor-docker-gc; clear it once Andrew's follow-up is done
        if t.get("dev_stack_in_use") and not any(str(f.get("task")) == tid and f.get("id") in open_ids
                                                 for f in followups.values() if isinstance(f, dict)):
            out.append(f"{name}: dev_stack_in_use set but no open follow-up for it -> conductor-ledger del tasks.{tid}.dev_stack_in_use")
        if stage == "parked" and s and s.get("session_status") == "busy":
            out.append(f"{name}: parked but its worker is busy -> update the stage")

    for q in qs:
        p = isinstance(q, dict) and q.get("proposal")
        if p and q.get("status") == "answered" and not p.get("created") \
                and re.match(r"\s*(approve|yes|ok|go)\b", str(q.get("answer") or ""), re.I):
            out.append(f"proposal {q['id']} ({p.get('title', '')[:60]}) approved, not created -> conductor-propose create {q['id']}")

    for tid, s in live.items():
        if tid not in tasks and s.get("project") not in PAUSED_PROJECTS:
            out.append(f"{s.get('title', '')[:60]} ({tid}): in progress in developerly, not in the ledger -> adopt it or complete it")

    for k, v in jobs.items():
        started = ts(v.get("started"))
        if started and (mins(started) or 0) > JOB_HOURS * 60 and str(v.get("task")) in running:
            out.append(f"job {k} started {v.get('started')} still listed -> if it's not running, delete jobs.{k}")

    busy = {}
    for tid, t in tasks.items():
        s = live.get(tid)
        if isinstance(t, dict) and t.get("stage") in WORKING and not t.get("expedite") and \
                (tid in running or (s and s.get("session_status") == "busy")):
            busy[t.get("project") or (s or {}).get("project")] = busy.get(t.get("project") or (s or {}).get("project"), 0) + 1
    total = sum(busy.values())
    # Finish-first mode (Andrew, 2026-10-19, D-entry in overrides.finish_first): free slots stay empty
    # except for urgent todo tasks - expedite, pinned (focus), or listed in overrides.finish_first.urgent_ids.
    ov = led.get("overrides") or {}
    ff = ov.get("finish_first") or {}
    launchable = todo
    if ff.get("active"):
        urgent = {str(i) for i in (ff.get("urgent_ids") or [])} | {str(i) for i in (ov.get("pins") or [])}
        urgent |= {tid for tid, t in tasks.items() if isinstance(t, dict) and t.get("expedite")}
        launchable = [t for t in todo if str(t["local_id"]) in urgent]
    for proj in sorted({t["project"] for t in launchable}):
        free = min(PER_PROJECT - busy.get(proj, 0), TOTAL - total)
        if free > 0:
            n = sum(1 for t in launchable if t["project"] == proj)
            what = "urgent todo (finish-first mode)" if ff.get("active") else "todo"
            out.append(f"{proj}: {busy.get(proj, 0)} actually running, {n} {what} -> launch into {free} free slot(s) now")

    try:
        gc = subprocess.run([os.path.join(HERE, "conductor-docker-gc"), "--dry-run"], capture_output=True, text=True, timeout=120).stdout
        # conductor-docker-gc already skips stacks of tasks Andrew is using (dev_stack_in_use / open follow-up
        # needing the dev server); belt and braces: never report a stack whose name ends in such a task id
        keep = {tid for tid, t in tasks.items() if isinstance(t, dict) and t.get("dev_stack_in_use")}
        keep |= {str(f.get("task")) for f in followups.values() if isinstance(f, dict) and f.get("id") in open_ids
                 and (f.get("needs_dev_server") or "localhost:" in str(f.get("what", "")))}
        idle = [p for p in (l.split()[2] for l in gc.splitlines() if l.startswith("would stop"))
                if not any(p.endswith(f"_{k}") for k in keep)]
        if idle:
            out.append(f"Docker: {len(idle)} stack(s) running for tasks not using them ({', '.join(idle[:4])}{'...' if len(idle) > 4 else ''}) -> run conductor-docker-gc")
    except Exception:  # noqa: BLE001
        pass
    try:
        nets = len(subprocess.run(["docker", "network", "ls", "-q"], capture_output=True, text=True, timeout=30).stdout.split())
        if nets >= 25:
            out.append(f"Docker: {nets} networks (launches fail at ~30) -> run conductor-docker-gc")
    except Exception:  # noqa: BLE001
        pass

    # Beta was down 24 min on 2026-10-23 before anyone noticed: live checks only curl /up per task.
    # Every audit (each tick, and every 5 min via conductor-web-wait) checks the shared hosts.
    for url in HEALTH:
        try:
            r = subprocess.run(["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code} %{time_total}", "-m", "15", url],
                               capture_output=True, text=True, timeout=20)
            code, secs = (r.stdout.split() + ["000", "15"])[:2]
            if code != "200":
                out.append(f"{url} returned {code} -> INCIDENT: policy.md Incidents, before any other step")
            elif float(secs) > SLOW_SECS:
                out.append(f"{url} slow (over {SLOW_SECS}s) -> INCIDENT: policy.md Incidents, check host load first")
        except Exception:  # noqa: BLE001
            out.append(f"{url} unreachable -> INCIDENT: policy.md Incidents, before any other step")

    if "--new" in sys.argv:
        seen = {}
        try:
            seen = json.load(open(SEEN))
        except (FileNotFoundError, ValueError):
            pass
        now = time.time()
        key = lambda line: re.sub(r"\d+ min", "", line)  # noqa: E731
        fresh = [line for line in out if now - seen.get(key(line), 0) > 1800]
        seen = {k: v for k, v in seen.items() if now - v < 86400}
        seen.update({key(line): now for line in fresh})
        json.dump(seen, open(SEEN, "w"))
        out = fresh
    for line in out:
        print(line)


if __name__ == "__main__":
    main()
